# === API Keys ===
# Copy this file to .env and fill in your keys

# Genius API (get from https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=your_genius_token_here

# RapidAPI TikTok API key (tiktok-api23.p.rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube Data API v3
# HOW TO GET IT (free, ~10,000 requests/day):
# 1. Go to https://console.cloud.google.com
# 2. Create new project (e.g., "SUPA-Viral-Lyrics")
# 3. Search "YouTube Data API v3" → Enable it
# 4. Go to Credentials → Create Credentials → API Key
# 5. Copy the key below
YOUTUBE_API_KEY=your_youtube_key_here
